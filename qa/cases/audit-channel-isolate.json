{
  "id": "audit-channel-isolate",
  "title": "Channel selector (r/g/b/a modes) isolates on decoded media",
  "source": {
    "kind": "video",
    "fixture": "qa/fixtures/ci-smoke.mp4"
  },
  "transport": {
    "start": true,
    "settleMs": 1200
  },
  "recording": {
    "filename": "audit-channel-isolate",
    "tailMs": 700
  },
  "expectations": {
    "sourceKind": "video",
    "audioActive": true,
    "allowConsoleErrors": ["favicon.ico"]
  },
  "audit": {
    "family": "channel-select",
    "operator": "channel",
    "kind": "isolate",
    "path": "operator-regression",
    "expectedVideo": [
      "setting channel.mode to 0/1/2/3 and previewing bus 1 should show a single greyscale channel from the decoded fixture (red bar → bright on r, dim on g/b, etc.)",
      "mode=3 (alpha) on a fully-opaque clip reads as luma via max(c.a, luma(c.rgb)) in channel.frag",
      "no NaN or black frames at any mode"
    ],
    "expectedAudio": [
      "channel selector is visual-only; the audio mix is unchanged across mode changes"
    ],
    "manualChecks": [
      "Do modes 0/1/2 each produce a distinct greyscale image consistent with the fixture's colour bars?",
      "Does mode 3 (alpha fallback) read as a luma proxy rather than collapsing to black?",
      "Does routing channel to a non-default bus leave the rest of the chain unaffected?"
    ]
  },
  "steps": [
    {
      "type": "set-operator-param",
      "op": "channel",
      "paramId": "mode",
      "value": 0,
      "screenshot": "channel-mode-r"
    },
    {
      "type": "set-node-bus",
      "op": "channel",
      "bus": 1,
      "screenshot": "channel-r-bus1"
    },
    {
      "type": "set-monitor-bus",
      "bus": 1,
      "screenshot": "channel-r-monitor"
    },
    {
      "type": "wait",
      "ms": 350,
      "screenshot": "channel-r-hold"
    },
    {
      "type": "set-operator-param",
      "op": "channel",
      "paramId": "mode",
      "value": 1,
      "screenshot": "channel-mode-g"
    },
    {
      "type": "wait",
      "ms": 350,
      "screenshot": "channel-g-hold"
    },
    {
      "type": "set-operator-param",
      "op": "channel",
      "paramId": "mode",
      "value": 2,
      "screenshot": "channel-mode-b"
    },
    {
      "type": "wait",
      "ms": 350,
      "screenshot": "channel-b-hold"
    },
    {
      "type": "set-operator-param",
      "op": "channel",
      "paramId": "mode",
      "value": 3,
      "screenshot": "channel-mode-a"
    },
    {
      "type": "wait",
      "ms": 350,
      "screenshot": "channel-a-hold"
    },
    {
      "type": "set-operator-param",
      "op": "channel",
      "paramId": "mode",
      "value": 0
    },
    {
      "type": "set-node-bus",
      "op": "channel",
      "bus": 0
    },
    {
      "type": "set-monitor-bus",
      "bus": 0,
      "screenshot": "channel-monitor-reset"
    }
  ]
