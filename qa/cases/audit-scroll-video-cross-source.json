{
  "id": "audit-scroll-video-cross-source",
  "title": "Scroll cross-source spot check on committed video fixture",
  "source": {
    "kind": "video",
    "fixture": "qa/fixtures/ci-smoke.mp4"
  },
  "transport": {
    "start": true,
    "settleMs": 1500
  },
  "recording": {
    "filename": "audit-scroll-video-cross-source",
    "tailMs": 850
  },
  "expectations": {
    "sourceKind": "video",
    "minVideoAdvanceSeconds": 1,
    "audioActive": true,
    "allowConsoleErrors": ["favicon.ico"],
    "metricComparisons": [
      {
        "from": "scroll-video-static-hold",
        "to": "scroll-video-moving-hold",
        "domain": "video",
        "metric": "temporalDiff",
        "op": ">",
        "delta": 0.01,
        "description": "adding scroll motion should materially increase decoded-media frame movement"
      },
      {
        "from": "scroll-video-static-hold",
        "to": "scroll-video-moving-hold",
        "domain": "audio",
        "metric": "spectralFlux",
        "op": ">",
        "delta": 0.0015,
        "source": "exported-audio",
        "segmentPaddingMs": 220,
        "description": "introducing scroll should materially increase rendered decoded-media spectral movement"
      }
    ]
  },
  "audit": {
    "family": "geometry-spatial",
    "operator": "scroll",
    "kind": "cross-source",
    "path": "product",
    "expectedVideo": [
      "the decoded fixture should drift horizontally and vertically without freezing or exposing undefined edges",
      "the moving state should visibly differ from the static state on the committed clip"
    ],
    "expectedAudio": [
      "fixture audio should pick up the same delay-scrub behavior as the osc case",
      "the rendered mix should stay continuous with no collapse or silence"
    ],
    "manualChecks": [
      "Does scroll remain legible and coupled on decoded media?",
      "Does the moving state feel like one AV gesture rather than separate audio and video artifacts?"
    ]
  },
  "steps": [
    {
      "type": "set-operator-param",
      "op": "scroll",
      "paramId": "x",
      "value": 0.08,
      "screenshot": "scroll-video-static-x"
    },
    {
      "type": "set-operator-param",
      "op": "scroll",
      "paramId": "speedX",
      "value": 0,
      "screenshot": "scroll-video-static-speedX"
    },
    {
      "type": "wait",
      "ms": 320,
      "screenshot": "scroll-video-static-hold"
    },
    {
      "type": "set-operator-param",
      "op": "scroll",
      "paramId": "x",
      "value": 0.68,
      "screenshot": "scroll-video-moving-x"
    },
    {
      "type": "set-operator-param",
      "op": "scroll",
      "paramId": "speedX",
      "value": 1.8,
      "screenshot": "scroll-video-moving-speedX"
    },
    {
      "type": "set-operator-param",
      "op": "scroll",
      "paramId": "y",
      "value": 0.35,
      "screenshot": "scroll-video-moving-y"
    },
    {
      "type": "wait",
      "ms": 620,
      "screenshot": "scroll-video-moving-hold"
    }
  ]
}
